# Copy to .env and fill in; run commands with `uv run --env-file .env teacher ...`.
# Never commit real values (.env is git-ignored; this file is not).

# Which database: supabase (production, the default) or sqlite (the local file teacher.db under
# TEACHER_HOME, for working locally and testing). `teacher --db ...` overrides it per command.
# TEACHER_DB=sqlite

# The Supabase Postgres connection string (a secret; Teacher never prints it). Needed when the
# database is supabase. Use the Session pooler string from the Supabase project's Connect
# dialog (postgresql://postgres.<project>:<password>@<region>.pooler.supabase.com:5432/postgres);
# the transaction pooler (port 6543) also works.
SUPABASE_DB_URL=

# Where the data folders (knowledge_sources/, artifacts/, derived/, backups/) and the SQLite
# file live; Supabase's folders are in supabase/ under it. Default: the current directory.
# TEACHER_HOME=/path/to/teacher-data

# Anthropic API key: writing study pages, grading written answers, the tutor.
ANTHROPIC_API_KEY=

# OpenAI API key: embeddings for concept search and the concept graph.
OPENAI_API_KEY=

# YouTube Data API v3 key: needed only to add YouTube videos as sources.
# YOUTUBE_API_KEY=

# Access code for registering accounts: with it set, every page and API route needs signing in
# with a user account, and registering one needs this code (nobody signs in with it). Required
# to serve on anything but 127.0.0.1/localhost.
# TEACHER_PASSWORD=

# Optional model overrides (defaults shown).
# TEACHER_GENERATION_MODEL=claude-sonnet-5-5
# TEACHER_CONCEPT_MODEL=claude-sonnet-5-5
# TEACHER_TUTOR_MODEL=claude-opus-5-5
# TEACHER_JUDGE_MODEL=claude-haiku-5-5
# TEACHER_METADATA_MODEL=claude-haiku-5-5
# TEACHER_EMBEDDING_MODEL=text-embedding-3-small

# Optional: use a Pyodide install somewhere else (default derived/pyodide/<version>).
# TEACHER_PYODIDE_DIR=
