{
  "title": "True-fan calculator",
  "instructions": "Move the sliders to change the income you need and the amount each true fan spends per year. Watch how many fans you need. Try Kelly's examples: $50 per fan with $100,000 needed (2,000 fans), $200 (500 fans), and $75,000 needed at $100 per fan. These are Kelly's illustrative cases, not measured results.",
  "html": "<div><label>Income needed per year ($): <input id=\"inc\" type=\"range\" min=\"20000\" max=\"200000\" step=\"5000\" value=\"100000\"></label> <output id=\"incv\"></output></div><div><label>Spend per true fan per year ($): <input id=\"fan\" type=\"range\" min=\"25\" max=\"400\" step=\"5\" value=\"100\"></label> <output id=\"fanv\"></output></div><div><label>Share of payment you keep (%): <input id=\"keep\" type=\"range\" min=\"10\" max=\"100\" step=\"5\" value=\"100\"></label> <output id=\"keepv\"></output></div><p>True fans needed: <output id=\"res\"></output></p><div id=\"bar\" style=\"height:16px;background:var(--surface);border:1px solid var(--border)\"><div id=\"fill\" style=\"height:100%;background:var(--accent);width:0\"></div></div><p style=\"color:var(--muted)\">Bar scale: up to 10,000 fans.</p><style>div label{display:inline-block;margin:4px 0}</style><script>function u(){var i=+document.getElementById('inc').value,f=+document.getElementById('fan').value,k=+document.getElementById('keep').value;document.getElementById('incv').textContent='$'+i;document.getElementById('fanv').textContent='$'+f;document.getElementById('keepv').textContent=k+'%';var n=Math.ceil(i/(f*k/100));document.getElementById('res').textContent=n.toLocaleString();document.getElementById('fill').style.width=Math.min(100,n/100)+'%';}['inc','fan','keep'].forEach(function(id){document.getElementById(id).addEventListener('input',u)});u();</script>"
}
