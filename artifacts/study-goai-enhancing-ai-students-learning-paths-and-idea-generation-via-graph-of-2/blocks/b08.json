{
  "title": "Beam search over a toy citation graph",
  "instructions": "This uses **made-up** scores, not the paper's data, to show the mechanism. The LLM's pruning is replaced by a fixed relevance score. Pick a beam width N (1 to 3) and step through the iterations. Watch how only the top-N paths survive each step and how paths grow by one hop each time.",
  "html": "<style>.row{margin:6px 0}.p{padding:4px 8px;border:1px solid var(--border);border-radius:6px;margin:3px 0;background:var(--surface)}.small{color:var(--muted);font-size:.9em}</style><div><div class=\"row\"><label for=\"n\">Beam width N: </label><input id=\"n\" type=\"range\" min=\"1\" max=\"3\" value=\"2\"><output id=\"nv\">2</output></div><div class=\"row\"><button id=\"step\" class=\"primary\">Next iteration</button> <button id=\"reset\">Reset</button></div><div id=\"out\"></div><p class=\"small\">Toy neighbours and scores (invented): Start→A(0.9), B(0.7), C(0.4). A→D(0.8), E(0.6). B→F(0.9), G(0.3). C→H(0.5). D→I(0.7). F→J(0.95), K(0.2). E→L(0.4).</p></div><script>var G={S:{A:.9,B:.7,C:.4},A:{D:.8,E:.6},B:{F:.9,G:.3},C:{H:.5},D:{I:.7},F:{J:.95,K:.2},E:{L:.4}};var paths,it;var n=document.getElementById('n'),nv=document.getElementById('nv'),out=document.getElementById('out');function reset(){paths=[{nodes:['S'],score:0}];it=0;render('Start: one path containing the key reference S.')}function render(msg){var h='<div class=\"row\"><b>Iteration '+it+'</b> — '+msg+'</div>';paths.forEach(function(p){h+='<div class=\"p\">'+p.nodes.join(' → ')+' <span class=\"small\">(total score '+p.score.toFixed(2)+')</span></div>'});out.innerHTML=h}document.getElementById('step').onclick=function(){var N=+n.value,c=[];paths.forEach(function(p){var e=p.nodes[p.nodes.length-1],nb=G[e];if(nb){for(var k in nb)c.push({nodes:p.nodes.concat([k]),score:p.score+nb[k]})}else c.push(p)});c.sort(function(a,b){return b.score-a.score});var before=c.length;paths=c.slice(0,N);it++;render('collected '+before+' candidate paths, kept top '+N+'.')};document.getElementById('reset').onclick=reset;n.oninput=function(){nv.textContent=n.value;reset()};reset();</script>"
}
